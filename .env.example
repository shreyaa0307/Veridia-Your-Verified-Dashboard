# =============================================================================
# Veridia – Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local (at the project root) and edit as needed.
# .env.local is gitignored.
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL – Backend API base URL
# ──────────────────────────────────────────────────────────────────────────────
# During local development the Vite dev server proxies /api → http://127.0.0.1:8000,
# so you do NOT need to set this for local development.
#
# Set this for production builds where the backend lives on a different host:
# VITE_API_BASE_URL=https://api.yourdomain.com
