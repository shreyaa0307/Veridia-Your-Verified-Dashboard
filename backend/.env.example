# =============================================================================
# Veridia – Backend Environment Variables
# =============================================================================
# Copy this file to backend/.env.local (or backend/.env) and fill in your real values.
# .env and .env.local files are gitignored and will NEVER be committed.
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# LLM API Configuration
# ──────────────────────────────────────────────────────────────────────────────

# Groq API key – required for dashboard generation
# Get one at https://console.groq.com
GROQ_API_KEY=

# Google Gemini API key – optional refinement pass; Groq works without it
# Get one at https://ai.google.dev
# GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL – Groq Model IDs
# Defaults use llama-3.3-70b-versatile. Override only with model IDs enabled for your Groq account.
# ──────────────────────────────────────────────────────────────────────────────
GROQ_MODEL_ANALYSIS=llama-3.3-70b-versatile
GROQ_MODEL_DESIGN=llama-3.3-70b-versatile
GROQ_MODEL_CODE=llama-3.3-70b-versatile
GROQ_MODEL_OPTIMIZE=llama-3.3-70b-versatile

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL – Server / CORS / Port Configuration
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins
# In production, set this to your exact frontend origin (e.g., https://yourdomain.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Backend port (default: 8000)
BACKEND_PORT=8000

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL – Runtime Directory Overrides
# ──────────────────────────────────────────────────────────────────────────────
# UPLOAD_DIR=
# DASHBOARD_DIR=
# CHROMA_DIR=
# R_OUTPUT_DIR=
