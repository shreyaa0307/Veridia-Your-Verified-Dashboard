# =============================================================================
# Veridia – Backend Environment Variables
# =============================================================================
# Copy this file to backend/.env.local and fill in your real values.
# backend/.env.local is gitignored and will NEVER be committed.
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED – LLM API keys
# ──────────────────────────────────────────────────────────────────────────────

# Groq API key – required for dashboard generation
# Get one at https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Google Gemini API key – optional enrichment / fallback
# Get one at https://ai.google.dev
GEMINI_API_KEY=AIza_YOUR_GEMINI_API_KEY_HERE

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL – Runtime directory overrides
# (defaults are relative to the backend directory; set these for Docker or
#  production deployments where you want data in specific mount paths)
# ──────────────────────────────────────────────────────────────────────────────

# Where uploaded CSV files are stored
# UPLOAD_DIR=/tmp/uploads

# Where generated dashboard Python files are saved
# DASHBOARD_DIR=/tmp/generated_dashboards

# ChromaDB vector store directory
# CHROMA_DIR=/tmp/chroma_db

# R visualization output directory
# R_OUTPUT_DIR=/tmp/generated_visualization

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL – Server / CORS configuration
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Defaults to localhost:3000, localhost:5173, 127.0.0.1:3000, 127.0.0.1:5173, *
# In production, replace "*" with your exact frontend URL:
# CORS_ORIGINS=https://yourdomain.com

# Backend port (used by uvicorn; default 8000)
# BACKEND_PORT=8000

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL – Docker / reverse-proxy settings
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated frontend origins forwarded via docker-compose
# FRONTEND_ORIGINS=http://localhost:8080
